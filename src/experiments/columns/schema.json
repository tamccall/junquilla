            "properties": {
              "junkPercentName": { "type": "string" },
              "junkStatusName": { "type": "string" },
              "statusText": {
                "type": "object",
                "optional": true,
                "additionalProperties": { "type": "string" }
              }
            }
          }
        ]
      },
      {
        "name": "unregister",
        "type": "function",
        "async": true,
        "description": "Removes both columns and all listeners.",
        "parameters": []
      }
    ]
  }
