<?xml version='1.0' encoding='UTF-8'?>

<RDF xmlns='http://www.w3.org/1999/02/22-rdf-syntax-ns#'
     xmlns:em='http://www.mozilla.org/2004/em-rdf#'>

  <Description about='urn:mozilla:install-manifest'>
    <em:id>junquilla@mesquilla.com</em:id>
    <em:version>0.2.20090216</em:version>
    <em:type>2</em:type> <!-- 2 is type 'extension' -->
    <em:name>JunQuilla</em:name>
    <em:creator>R Kent James</em:creator>
    <em:description>Junk mail management by Mesquilla</em:description>
    <em:homepageURL>http://mesquilla.com/extensions/junquilla</em:homepageURL>
    <em:aboutURL>chrome://junquilla/content/about.xul</em:aboutURL>
    <em:optionsURL>chrome://junquilla/content/junquillaSetupWindow.xul</em:optionsURL>
    <!-- Thunderbird -->
    <em:targetApplication>
      <Description>
        <em:id>{3550f703-e582-4d05-9a08-453d09bdfdc6}</em:id>
        <em:minVersion>3.0b2pre</em:minVersion>
        <em:maxVersion>3.0b3pre</em:maxVersion>
      </Description>
    </em:targetApplication>
  </Description>
</RDF>
